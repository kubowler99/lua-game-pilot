# EditorConfig configuration for lua-game-pilot
# See: https://editorconfig.org/

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Lua files
[*.lua]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown files
[*.md]
trim_trailing_whitespace = false  # Allow trailing spaces for line breaks
max_line_length = off

# JSON files
[*.json]
indent_size = 2

# YAML files (for potential CI/CD configs)
[*.{yml,yaml}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Makefiles (must use tabs)
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Configuration files
[*.{rockspec,busted,luacov,luacheckrc}]
indent_size = 2

# Solar2D specific files
[{config.lua,build.settings}]
indent_size = 2

# Git configuration
[.gitignore]
trim_trailing_whitespace = true

# Documentation
[*.{txt,rst}]
max_line_length = off
